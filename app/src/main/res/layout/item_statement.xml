<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:layout_marginHorizontal="@dimen/dp_14"
    android:layout_marginVertical="@dimen/dp_8"
    app:cardCornerRadius="@dimen/dp_8"
    app:cardElevation="@dimen/dp_10">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp_16">

        <TextView
            android:id="@+id/tv_date_label"
            style="@style/Style_text_title_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pension withdrawn on"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_date"
            style="@style/Style_text_title_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01/07/2023"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/tv_date_label"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_description"
            style="@style/Style_text_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_20"
            android:text="Description"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_date"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/iv_naira"
            app:layout_constraintTop_toTopOf="@id/tv_amount"
            app:layout_constraintEnd_toStartOf="@id/tv_amount"
            app:layout_constraintBottom_toBottomOf="@id/tv_amount"
            android:layout_width="@dimen/dp_12"
            android:layout_height="@dimen/dp_12"
            app:tint="@color/colorPrimary"
            android:layout_marginEnd="@dimen/dp_3"
            android:src="@drawable/ic_naira"/>
        <TextView
            android:id="@+id/tv_amount"
            android:fontFamily="@font/nunito_sans_regular"
            android:textColor="@color/green_theme"
            android:textSize="@dimen/dp_16"
            android:text="100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>