<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:layout_marginHorizontal="@dimen/dp_14"
    android:layout_marginVertical="@dimen/dp_16"
    app:cardCornerRadius="@dimen/dp_8"
    app:cardElevation="@dimen/dp_10">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp_16">

        <TextView
            android:id="@+id/tv_time_label"
            style="@style/Style_text_title_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/verified_on"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:id="@+id/tv_time"
            style="@style/Style_text_title_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01/07/2023"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_time_label" />

        <ImageView
            android:id="@+id/iv_status"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintEnd_toStartOf="@+id/tv_status"
            app:layout_constraintTop_toTopOf="@+id/tv_status"
            android:src="@drawable/ic_tick_green"
            app:layout_constraintBottom_toBottomOf="@+id/tv_status"/>
        <TextView
            android:id="@+id/tv_status"
            android:fontFamily="@font/nunito_sans_regular"
            android:textColor="@color/green_theme"
            android:textSize="@dimen/dp_16"
            android:text="Verified"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>